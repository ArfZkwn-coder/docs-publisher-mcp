    {
      "parameters": {
        "jsCode": "// EDIT THIS: your own Telegram chat ID. Send /myid to the bot to find it.\nconst OWNER_CHAT_ID = '123456789';\n\n// Decides what a message asks for. Only the owner can approve, revoke or list keys.\nconst msg = $input.first().json.message ?? {};\nconst chatId = String(msg.chat?.id ?? '');\nconst text = String(msg.text ?? '').trim();\nconst from = msg.from ?? {};\nconst ownerSet = /^-?\\d+$/.test(OWNER_CHAT_ID);\nconst isOwner = ownerSet && chatId === OWNER_CHAT_ID;\nconst clean = (s) => String(s ?? '').trim().toLowerCase()\n  .replace(/[^a-z0-9._-]+/g, '-').replace(/^[^a-z0-9]+/, '').slice(0, 32);\n// Messages are sent as HTML, so escape anything that came from the sender.\nconst esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst [command = '', ...args] = text.split(/\\s+/);\nconst cmd = command.toLowerCase().replace(/@.*$/, '');\n\nconst out = { action: 'ignore', chatId, ownerChatId: OWNER_CHAT_ID };\nif (cmd === '/myid' || !ownerSet) {\n  out.action = 'myid';\n} else if (isOwner && cmd === '/approve' && /^-?\\d+$/.test(args[0] ?? '') && clean(args[1])) {\n  Object.assign(out, { action: 'approve', targetChatId: args[0], name: clean(args[1]) });\n} else if (isOwner && cmd === '/revoke' && clean(args[0])) {\n  Object.assign(out, { action: 'revoke', name: clean(args[0]) });\n} else if (isOwner && cmd === '/list') {\n  out.action = 'list';\n} else if (isOwner) {\n  out.action = 'help';\n} else if (cmd === '/start' || cmd === '/access') {\n  Object.assign(out, {\n    action: 'request',\n    requester: esc([from.first_name, from.last_name].filter(Boolean).join(' ') || 'Seseorang'),\n    username: from.username ? '@' + esc(from.username) : '(tiada username)',\n    name: clean(from.username || from.first_name) || 'user' + chatId.replace('-', ''),\n  });\n}\nreturn [{ json: out }];"
      },
