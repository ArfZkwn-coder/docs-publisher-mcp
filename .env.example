# Settings for the hosted connector. Copy to .env and fill in; never share or commit .env.

# Fine-grained GitHub token for the docs repo only:
# Contents and Pull requests set to "Read and write".
GITHUB_TOKEN=
DOCS_REPO=ArfZkwn-coder/docsXAi
DOCS_BRANCH=main
DOCS_DIR=docs

# The owner's key: the secret part of your connector URL (https://<your-host>/mcp/<MCP_SECRET>).
# At least 24 random characters, e.g. from: openssl rand -hex 24
# Give other people their own keys with src/keys-cli.js instead of sharing this one.
MCP_SECRET=

# The public address, used when printing personal connector URLs.
PUBLIC_URL=

# Optional: token for the private admin API (port 8788) that n8n uses to create keys.
# At least 24 random characters. Leave empty to turn the admin API off.
ADMIN_TOKEN=

# Every change is committed straight to the docs branch: anyone with a connector URL can publish.
# true (the default): rebuild and deploy the site automatically after each change.
AUTO_DEPLOY=true
